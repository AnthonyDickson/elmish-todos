<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ElmishTodos.Shared</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Fable>true</Fable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Coders.fs" />
    <Compile Include="ApiError.fs" />
    <Compile Include="Todo.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Thoth.Json.Net" Condition="'$(FABLE_COMPILER)' == ''" />
    <PackageReference Include="Thoth.Json"     Condition="'$(FABLE_COMPILER)' != ''" />
  </ItemGroup>

</Project>
